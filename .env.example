# OpenRouter (https://openrouter.ai/keys). Needed for metadata extraction, answers, conflicts.
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# MOCK_MODE=1 (or no key) keeps the app running without the API: metadata falls back to the
# filename, answers quote the top source, conflicts are not detected. Set to 0 for real use.
MOCK_MODE=0
